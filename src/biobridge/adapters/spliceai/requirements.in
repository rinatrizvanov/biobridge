# SpliceAI engine environment for BioBridge (macOS arm64, CPython 3.11).
# Compile to engine.lock with scripts/lock_engine.sh; never edit engine.lock by hand.
#
# spliceai is installed unmodified from PyPI. See docs/licensing-evidence.md
# (code: GPLv3 as released in 1.3.1; model weights: treated as CC BY-NC 4.0).
spliceai==1.3.1

# Keras 2 is required: Keras 3 (TensorFlow >= 2.16) cannot load SpliceAI's legacy .h5 models.
tensorflow==2.15.1
keras==2.15.0

# TensorFlow 2.15 requires numpy < 2.
numpy>=1.26,<2

# spliceai imports pkg_resources, which setuptools 82.0.0 removed.
setuptools<82

# tensorflow-metal is deliberately excluded (GPU kernels can change numerical results).

# Conservative: spliceai 1.3.1 (2020) predates pandas 3's default string dtype.
pandas<3
